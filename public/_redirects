# Identity-proxy crawl files first. Cloudflare follows _redirects even when a
# matching static asset exists, so /* must not rewrite robots.txt or sitemap.xml.
/robots.txt /robots.txt 200
/sitemap.xml /sitemap.xml 200

# Do not 200-rewrite exact SPA paths to /index.html. Workers / Pages
# html_handling pretty-URLs /index.html → / with a 308, so a share or
# hard refresh of /reported-nil (and /methods, /compare, /tape, /tv,
# /buyout, /coach-fa) bounced home. Nested /school/:id and /coach-fa/:id
# already 200 without an exact rewrite — keep the splats. Exact shells
# are real dist/*.html files from scripts/write-spa-html.mjs.
/school/* /index.html 200
/coach-fa/* /index.html 200
